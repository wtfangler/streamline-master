  "icon": "assets/streamline_loader/icon.png",
  "environment": "client",
  "mixins": [
    { "config": "streamline_loader.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "${minecraft}"
  }
}
